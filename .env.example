###############################################################################
# SuvShare - environment configuration
#
# Quick start on any fresh VPS:
#   cp .env.example .env
#   nano .env            # set PASSWORD (that is the only mandatory change)
#   docker compose up -d --build
#
# Everything below except PASSWORD already has a working default, so a blank
# .env with only PASSWORD set is a valid production config.
###############################################################################


# =============================================================================
# REQUIRED - the app refuses to start without this
# =============================================================================

# Login password for the web UI, uploads, and all admin APIs.
# This is the single credential for the whole app. There is no user account
# system: whoever knows this password can upload and manage files.
# Downloads via /d/<id> links stay public and need no password.
# Generate a strong one:  openssl rand -base64 24
PASSWORD=ChangeMeToSomethingStrong


# =============================================================================
# OPTIONAL - safe to leave exactly as-is
# =============================================================================

# Host + container port the server listens on.
# Change only if 3009 is already taken on the new machine.
PORT=3009

# Upload capacity ceiling in gigabytes. Uploads are rejected once the total
# size of ./uploads reaches this number.
MAX_STORAGE_LIMIT_GB=20

# Public base URL used to build shareable links.
# Leave EMPTY and the app derives links from the incoming request, which is
# correct for direct IP or port access (http://1.2.3.4:3009).
# Set it when you put a reverse proxy, Cloudflare Tunnel, or custom domain in
# front, otherwise generated links will point at the internal address.
#   Example: PUBLIC_URL=https://download.example.com
# No trailing slash.
PUBLIC_URL=

# ---- Telegram upload notifications (optional feature) ----
# Leave BOTH blank to disable notifications entirely; the app works fine
# without them and will not error.
# To enable: create a bot via @BotFather for the token, then get your numeric
# chat id from @userinfobot. Both values are required together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ZIP compression level for server-side folder downloads.
# 0 = store only (fastest, no CPU cost), 9 = smallest output (slow).
# 1 is a good default for already-compressed media like video and images.
ZIP_COMPRESSION_LEVEL=1


###############################################################################
# PERSISTENT DATA - nothing to configure, listed so you know what to back up
#
#   ./uploads/   every uploaded file and folder
#   ./data/      db.json, the index that maps share links to files
#
# Both are created automatically on first start and bind mounted by
# docker-compose.yml. Back up BOTH together: uploads without data/db.json means
# the files exist on disk but every share link returns 404.
#
# To migrate to another VPS: copy the repo, .env, uploads/ and data/, then run
# `docker compose up -d --build`. No other steps.
###############################################################################
